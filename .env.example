# Copy to .env; use the SAME Supabase project for browser and API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
# Blank uses the same-origin /api/v1 (Vite proxies this during development).
VITE_API_BASE_URL=
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set /repository-name/ for a GitHub Pages project; use / for Node hosting.
VITE_BASE_PATH=/
